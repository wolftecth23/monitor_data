generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Admin auth ----------

model AdminUser {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("Administrator") // Administrator | Resource Manager | Sub Admin
  createdAt    DateTime @default(now())
}

// ---------- Org structure ----------

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isAdmin     Boolean  @default(false)
  employees   Employee[]
  createdAt   DateTime @default(now())
}

model Team {
  id            String   @id @default(uuid())
  name          String   @unique
  parentId      String?
  parent        Team?    @relation("TeamHierarchy", fields: [parentId], references: [id])
  children      Team[]   @relation("TeamHierarchy")
  employees     Employee[]
  trackingSettings TrackingSettings?
  alertRules    AlertRuleTeam[]
  createdAt     DateTime @default(now())
}

model Employee {
  id           String     @id @default(uuid())
  firstName    String
  lastName     String
  email        String     @unique
  employeeId   String?
  status       String     @default("active") // active | inactive | deactivated
  teamId       String?
  team         Team?      @relation(fields: [teamId], references: [id])
  roleId       String?
  role         Role?      @relation(fields: [roleId], references: [id])
  installToken String     @unique @default(uuid())
  devices      Device[]
  screenshots  Screenshot[]
  activityEvents ActivityEvent[]
  alertLogs    AlertLog[]
  createdAt    DateTime   @default(now())
}

// ---------- Devices ----------

model Device {
  id           String    @id @default(uuid())
  employeeId   String
  employee     Employee  @relation(fields: [employeeId], references: [id])
  platform     String    // windows | macos | linux
  hostname     String
  ip           String?
  appVersion   String?
  status       String    @default("offline") // online | offline
  lastSeenAt   DateTime?
  createdAt    DateTime  @default(now())
  screenshots  Screenshot[]
  activityEvents ActivityEvent[]

  @@unique([employeeId, hostname])
}

// ---------- Screenshots ----------

model Screenshot {
  id          String   @id @default(uuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id])
  deviceId    String
  device      Device   @relation(fields: [deviceId], references: [id])
  filePath    String
  appName     String?
  windowTitle String?
  capturedAt  DateTime @default(now())
  flagged     Boolean  @default(false)
}

// ---------- Activity ----------

model ActivityEvent {
  id          String   @id @default(uuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id])
  deviceId    String
  device      Device   @relation(fields: [deviceId], references: [id])
  appName     String?
  windowTitle String?
  url         String?
  isIdle      Boolean  @default(false)
  startedAt   DateTime
  endedAt     DateTime?
  createdAt   DateTime @default(now())
}

// ---------- Tracking settings (per team) ----------

model TrackingSettings {
  id                  String   @id @default(uuid())
  teamId              String   @unique
  team                Team     @relation(fields: [teamId], references: [id])
  trackingEnabled     Boolean  @default(true)
  livestreamEnabled   Boolean  @default(true)
  captureScreenshots  Boolean  @default(true)
  screenshotFrequencySec Int   @default(300)
  appUrlTracking      Boolean  @default(true)
  keyboardMouseTracking Boolean @default(true)
  idleTimeoutSec      Int      @default(300)
  activeThresholdSec  Int      @default(30)
  updatedAt           DateTime @updatedAt
}

// ---------- Alerts ----------

model AlertRule {
  id             String   @id @default(uuid())
  name           String
  description    String?
  type           String   // inactivity | application | url
  config         Json     // { thresholdMinutes } | { apps: string[] } | { urls: string[] }
  deliveryMode   String   @default("individual") // individual | summary
  recipients     String[]
  teams          AlertRuleTeam[]
  logs           AlertLog[]
  createdAt      DateTime @default(now())
}

model AlertRuleTeam {
  id          String    @id @default(uuid())
  alertRuleId String
  alertRule   AlertRule @relation(fields: [alertRuleId], references: [id], onDelete: Cascade)
  teamId      String
  team        Team      @relation(fields: [teamId], references: [id])

  @@unique([alertRuleId, teamId])
}

model AlertLog {
  id          String    @id @default(uuid())
  alertRuleId String
  alertRule   AlertRule @relation(fields: [alertRuleId], references: [id])
  employeeId  String?
  employee    Employee? @relation(fields: [employeeId], references: [id])
  description String
  triggeredAt DateTime  @default(now())
}
