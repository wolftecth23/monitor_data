DATABASE_URL="postgresql://monitor:monitor@localhost:5433/monitor?schema=public"
JWT_SECRET="change-me-in-production"
PORT=4000
STORAGE_DIR="./storage"
CORS_ORIGIN="http://localhost:5173"

# The URL agent installers connect to. Must be reachable from employee
# machines — change this to your server's LAN IP or public domain once
# you're deploying beyond this dev machine.
PUBLIC_BACKEND_URL="http://localhost:4000"

# SMTP (optional - alerts are logged to console if unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Monitor Alerts <alerts@example.com>"

# Bootstrap admin (used by seed script)
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="ChangeMe123!"
